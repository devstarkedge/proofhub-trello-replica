{
  "name": "flowtask-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "FlowTask desktop application",
  "author": "FlowTask",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-desktop.mjs --with-backend",
    "build": "vite build",
    "build:win": "node scripts/build-desktop.mjs win",
    "build:mac": "node scripts/build-desktop.mjs mac",
    "start": "node scripts/start-desktop.mjs --with-backend",
    "electron": "node scripts/start-desktop.mjs --with-backend",
    "electron:dev": "node scripts/start-desktop.mjs --with-backend",
    "electron:client": "node scripts/start-desktop.mjs",
    "electron:preview": "npm run build && node scripts/start-desktop.mjs --preview",
    "electron:repair": "node scripts/repair-electron.mjs",
    "electron:smoke": "npm run build && node scripts/start-desktop.mjs --preview --smoke-test",
    "test:desktop": "node --test electron/tests/*.test.cjs electron/*.test.cjs",
    "pack": "node scripts/build-desktop.mjs dir",
    "dist:win": "npm run build:win",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "vite-bundle-analyzer dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.13.18",
    "@tiptap/core": "^3.10.2",
    "@tiptap/extension-image": "^3.10.2",
    "@tiptap/extension-link": "^3.10.2",
    "@tiptap/extension-mention": "^3.10.2",
    "@tiptap/extension-underline": "^3.10.2",
    "@tiptap/pm": "^3.10.2",
    "@tiptap/react": "^3.10.2",
    "@tiptap/starter-kit": "^3.10.1",
    "@tiptap/suggestion": "^3.10.2",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "emoji-picker-react": "^4.16.1",
    "framer-motion": "^12.29.2",
    "idb": "^8.0.3",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-country-flag": "^3.1.0",
    "react-datepicker": "^8.10.0",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.9.4",
    "react-snowfall": "^2.4.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.3.0",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.14",
    "tippy.js": "^6.3.7",
    "uiohook-napi": "1.5.5",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "terser": "^5.44.0",
    "vite": "^7.1.7",
    "vite-bundle-analyzer": "^1.2.3"
  },
  "build": {
    "appId": "com.flowtask.desktop",
    "productName": "FlowTask",
    "directories": {
      "app": "build/app",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*"
    ],
    "beforeBuild": "./scripts/before-build.cjs",
    "extraResources": [
      {
        "from": "build/app/node_modules/sharp",
        "to": "node_modules/sharp"
      },
      {
        "from": "build/app/node_modules/@img",
        "to": "node_modules/@img"
      },
      {
        "from": "build/app/node_modules/detect-libc",
        "to": "node_modules/detect-libc"
      },
      {
        "from": "build/app/node_modules/semver",
        "to": "node_modules/semver"
      },
      {
        "from": "build/app/node_modules/uiohook-napi",
        "to": "node_modules/uiohook-napi"
      },
      {
        "from": "build/app/node_modules/node-gyp-build",
        "to": "node_modules/node-gyp-build"
      },
      {
        "from": "build/app/node_modules/socket.io-client",
        "to": "node_modules/socket.io-client"
      },
      {
        "from": "build/app/node_modules/socket.io-parser",
        "to": "node_modules/socket.io-parser"
      },
      {
        "from": "build/app/node_modules/engine.io-client",
        "to": "node_modules/engine.io-client"
      },
      {
        "from": "build/app/node_modules/engine.io-parser",
        "to": "node_modules/engine.io-parser"
      },
      {
        "from": "build/app/node_modules/@socket.io/component-emitter",
        "to": "node_modules/@socket.io/component-emitter"
      },
      {
        "from": "build/app/node_modules/debug",
        "to": "node_modules/debug"
      },
      {
        "from": "build/app/node_modules/ms",
        "to": "node_modules/ms"
      },
      {
        "from": "build/app/node_modules/ws",
        "to": "node_modules/ws"
      },
      {
        "from": "build/app/node_modules/xmlhttprequest-ssl",
        "to": "node_modules/xmlhttprequest-ssl"
      }
    ],
    "win": {
      "icon": "build/Fav.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FlowTask-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/Fav.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "FlowTask-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/prebuilds/**/*"
    ]
  },
  "engines": {
    "node": "24.22.1"
  }
}
