# ═══════════════════════════════════════════════════════════════════════════════
# FlowTask Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# In production (Render), set these in the service's Environment tab.
#
# ⚠️  NEVER commit the real .env file to version control.
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ─── URLs ─────────────────────────────────────────────────────────────────────
# These are REQUIRED in production. Used for CORS, email links, redirects.
FRONTEND_URL=http://localhost:5173
CHATAPP_URL=http://localhost:5174

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-64-char-hex-secret>
JWT_EXPIRE=7d

# ─── Super Admin (platform-level role, never a workspace) ─────────────────────
# Creates the FIRST platform administrator directly as a global account — no
# workspace is created or required. Takes effect exactly once (tracked in the
# PlatformBootstrap collection); safe to leave set after that, it becomes a
# no-op. Do not commit a real password here — set it via your deployment
# platform's secret/environment mechanism.
# SUPER_ADMIN_BOOTSTRAP_EMAIL=you@example.com
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=<set a strong password via a secure secret store>
#
# Ongoing allowlist — checked on EVERY Super Admin login/request in addition
# to the database role (both must hold). This does NOT grant the role by
# itself. To grant the role to an additional account after initial bootstrap,
# use the explicit script (a deliberate action, never automatic-from-env):
#   node backend/scripts/grantSuperAdmin.js <email>
# SUPER_ADMIN_EMAILS=you@example.com,teammate@example.com

# ─── Chat Integration ────────────────────────────────────────────────────────
# These variables are required when CHAT_ENABLED=true in production.
CHAT_ENABLED=false

# Secret used to SIGN JWT tokens for ChatApp SSO login.
# ⚠️  MUST exactly match ChatApp's FLOWTASK_JWT_SECRET
CHAT_JWT_SECRET=<must-match-ChatApp-FLOWTASK_JWT_SECRET>

# Webhook endpoint on ChatApp backend that receives events.
CHAT_WEBHOOK_URL=https://flowtask-chat-app.onrender.com/api/chat/webhooks/flowtask

# ChatApp backend origin used for server-to-server SSO provisioning. When
# omitted it is derived from CHAT_WEBHOOK_URL.
CHAT_API_URL=https://flowtask-chat-app.onrender.com

# Secret used to SIGN webhook payloads (HMAC-SHA256).
# ⚠️  MUST exactly match ChatApp's FLOWTASK_WEBHOOK_SECRET
FLOWTASK_WEBHOOK_SECRET=<must-match-ChatApp-FLOWTASK_WEBHOOK_SECRET>

# Legacy alias — some code reads CHAT_WEBHOOK_SECRET. Keep same value as above.
CHAT_WEBHOOK_SECRET=<same-value-as-FLOWTASK_WEBHOOK_SECRET>

# ─── Redis (PRODUCTION ONLY) ───────────────────────────────────────────────
# NODE_ENV=production requires REDIS_URL. Other environments ignore it.
# Missing/invalid/unreachable Redis prevents production startup.
# Store the URL in your deployment secret manager; never print it.
# Legacy REDIS_HOST / REDIS_PORT / REDIS_PASSWORD are not supported.
# REDIS_URL=redis://<user>:<password>@<host>:<port>
# Prefer rediss:// for a hosted TLS endpoint.
# SOCKET_REDIS_ADAPTER=true
# Set false only for intentional single-instance production realtime delivery.
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=5000
# REDIS_SHUTDOWN_TIMEOUT_MS=5000
# REDIS_ERROR_LOG_INTERVAL_MS=60000

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Slack Integration ───────────────────────────────────────────────────────
# SLACK_ENABLED=true
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ─── Push Notifications (VAPID) ──────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=


# ─── Cloudflare R2 Screenshot Storage ────────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_REGION=auto
# Background worker check interval in hours for deleting expired screenshots (default: 12)
SCREENSHOT_EXPIRY_CHECK_WORKER=12
